// Public app configuration only. Never place an Auth0 client secret,
// RevenueCat secret key, or backend credential in an Apple app target.
AUTH0_DOMAIN = YOUR_TENANT.us.auth0.com
AUTH0_IOS_CLIENT_ID = YOUR_IOS_NATIVE_APP_CLIENT_ID
AUTH0_MACOS_CLIENT_ID = YOUR_MACOS_NATIVE_APP_CLIENT_ID
AUTH0_AUDIENCE = https:/$()/restartthread-api
BACKEND_BASE_URL = https:/$()/YOUR_WORKER.workers.dev
REVENUECAT_API_KEY = appl_YOUR_PUBLIC_APP_SDK_KEY
